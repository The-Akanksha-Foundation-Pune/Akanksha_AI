# Copy to .env and fill in real values
PORT=5000
CLIENT_URL=http://localhost:5173

# AI provider keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=

# Database Configuration
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
# Database that holds the app's own tables (chats, usage, learned queries)
AI_DB_NAME=AI

# Auth
JWT_SECRET=
# Sign-in from Tether's Prism card: must equal JWT_SECRET in Tether's server/.env. Empty = that route is off.
INTEGRATION_JWT_SECRET=

# Auth
# AUTH_MODE=dev allows sign-in by email only (local testing). Set GOOGLE_CLIENT_ID to switch to Google sign-in.
AUTH_MODE=dev
GOOGLE_CLIENT_ID=
AUTH_ALLOWED_DOMAIN=akanksha.org
SUPER_ADMIN_EMAILS=you@akanksha.org

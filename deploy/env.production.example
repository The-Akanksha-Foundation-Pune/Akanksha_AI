# Production .env for Akanksha AI. Copy to <checkout>/.env on the server (the repository root, not
# server/) and fill in the secrets. Never commit the filled-in file.

# Port Express listens on, localhost only; nginx is the public side. Check it is free first.
PORT=5080

# Public address, no trailing slash. Sign-in redirects and the Google callback are built from it:
# <CLIENT_URL>/api/modules/auth/google/callback must be an authorised redirect URI on the OAuth client.
CLIENT_URL=https://tether.akanksha.org/akanksha-ai
# The path part of CLIENT_URL with a slash on both ends; deploy/deploy.sh builds the client for it.
BASE_PATH=/akanksha-ai/

# Express serves client/dist itself.
SERVE_CLIENT=1

# Anthropic. Use a key made for production, not one that has been pasted into a chat.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# MySQL. The user needs SELECT on the data databases and full rights on AI_DB_NAME only.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=AFDW
# The app's own tables; the only database the app writes to.
AI_DB_NAME=AI
# Employee directory for Admin > Access (read-only).
EMPLOYEE_DB_NAME=AFDW

# Long random string; sessions are signed with it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google sign-in. Both are required: deploy/deploy.sh refuses to deploy without them, because the
# app would otherwise fall back to sign-in by typed email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_DOMAIN=akanksha.org
# Always-admins (comma-separated). They add everyone else in Admin > Access.
SUPER_ADMIN_EMAILS=
